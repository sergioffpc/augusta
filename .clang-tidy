# Enforces docs/adr/0012-coding-style.md (Google C++ Style Guide) as fully as
# clang-tidy can check. google-* is Google's own dedicated check group, but on
# its own it only covers a handful of style-guide rules; readability-* and
# modernize-* pick up the rest (identifier naming, braces, TODO format, using
# nullptr/override, range-based for, etc.) - google-cloud-cpp uses the same
# three-group combination for the same reason.
Checks: >
  google-*,
  readability-*,
  modernize-*,
  -modernize-use-trailing-return-type,
  -clang-analyzer-core.StackAddressEscape,
  -readability-convert-member-functions-to-static,
  -modernize-use-scoped-lock

# Trailing return type is a stylistic alternative the guide doesn't mandate
# either way, so it's the one thing above we don't turn into a hard rule.
#
# clang-analyzer-core.StackAddressEscape is disabled because of a false
# positive inside Flecs's own fluent term/query builder chain
# (addons/cpp/mixins/query/builder_i.hpp's `*this->term_ = flecs::term(...);
# return *this;`), reached via this codebase's
# `ecs.system(name).kind(phase).run(...)` pattern for a zero-component
# system (augusta::simulation/prediction/presentation World::Impl) - not a
# real bug in our code, and not fixable from the call site since it's
# Flecs's own header.
#
# readability-convert-member-functions-to-static is disabled because most
# module classes (physics::World, renderer::Renderer, networking::Client,
# ...) are still placeholder stubs awaiting real third-party integration
# (PhysX, Falcor, GameNetworkingSockets, Lua, Steam Audio) - their methods
# don't touch instance state yet only because there's no real state to
# touch, not because they're meant to be static. Chasing this check per
# stub would just mean undoing it the moment each real implementation
# lands.
#
# modernize-use-scoped-lock is disabled because this clang-tidy build
# (LLVM 21.1 on the Linux CI runner) segfaults analyzing it against a
# plain `std::lock_guard<std::mutex> lock(...)` declaration (crashes
# inside UseScopedLockCheck::diagOnSingleLock) - e.g. src/client/
# runtime.cpp's GetLatestPredictionState. A clang-tidy bug, not something
# fixable from our code.

WarningsAsErrors: "*"

HeaderFilterRegex: '^(src|tests)/.*\.h$'

CheckOptions:
  - { key: readability-identifier-naming.NamespaceCase,          value: lower_case }
  - { key: readability-identifier-naming.ClassCase,              value: CamelCase  }
  - { key: readability-identifier-naming.StructCase,             value: CamelCase  }
  - { key: readability-identifier-naming.EnumCase,               value: CamelCase  }
  - { key: readability-identifier-naming.UnionCase,              value: CamelCase  }
  - { key: readability-identifier-naming.TypeAliasCase,          value: CamelCase  }
  - { key: readability-identifier-naming.TypedefCase,            value: CamelCase  }
  - { key: readability-identifier-naming.TemplateParameterCase,  value: CamelCase  }
  - { key: readability-identifier-naming.FunctionCase,           value: CamelCase  }
  - { key: readability-identifier-naming.VariableCase,           value: lower_case }
  - { key: readability-identifier-naming.ParameterCase,          value: lower_case }
  - { key: readability-identifier-naming.ClassMemberCase,        value: lower_case }
  - { key: readability-identifier-naming.ClassMemberSuffix,      value: _          }
  - { key: readability-identifier-naming.PrivateMemberSuffix,    value: _          }
  - { key: readability-identifier-naming.ProtectedMemberSuffix,  value: _          }
  - { key: readability-identifier-naming.ConstexprVariableCase,   value: CamelCase }
  - { key: readability-identifier-naming.ConstexprVariablePrefix, value: k         }
  - { key: readability-identifier-naming.GlobalConstantCase,      value: CamelCase }
  - { key: readability-identifier-naming.GlobalConstantPrefix,    value: k         }
  - { key: readability-identifier-naming.StaticConstantCase,      value: CamelCase }
  - { key: readability-identifier-naming.StaticConstantPrefix,    value: k         }
  - { key: readability-identifier-naming.MemberConstantCase,      value: CamelCase }
  - { key: readability-identifier-naming.MemberConstantPrefix,    value: k         }
  - { key: readability-identifier-naming.EnumConstantCase,        value: CamelCase }
  - { key: readability-identifier-naming.EnumConstantPrefix,      value: k         }
  - { key: readability-identifier-naming.MacroDefinitionCase,     value: UPPER_CASE }
  - { key: readability-function-size.LineThreshold,               value: 60         }
