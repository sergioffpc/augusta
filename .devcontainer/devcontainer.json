// The Linux build environment CI's server-x64-linux job runs in (see
// Dockerfile), with the Linux client's system packages too, for VS Code or
// Codespaces: `make test` builds and tests the linux preset, augustac among it,
// with nothing else to install. The Windows client runs scripts/bootstrap.sh
// natively (MSVC has no container). scripts/dev-container.sh runs the same
// image from a terminal (macOS's git hooks run through it), with its own
// mounts: there the checkout keeps its host path.
{
  "name": "Augusta (Linux)",
  "build": {
    "dockerfile": "Dockerfile",
    // The repository, for scripts/bootstrap.sh, which the Dockerfile runs
    // (Dockerfile.dockerignore keeps the rest out of the context).
    "context": ".."
  },
  "remoteUser": "ubuntu",
  "containerEnv": {
    // CI's server-x64-linux job's binary cache: a files provider in the
    // checkout's gitignored .vcpkg-bincache (the job's env says why not the
    // NuGet feed).
    "VCPKG_BINARY_SOURCES": "clear;files,${containerWorkspaceFolder}/.vcpkg-bincache,readwrite"
  },
  "mounts": [
    // sccache's default cache directory, in a volume every container of the
    // repository shares, so a rebuilt container keeps its compiled objects.
    "source=augusta-sccache,target=/home/ubuntu/.cache/sccache,type=volume",
    // The build trees, one volume per container: a host build of the same
    // checkout keeps its own build/, whose CMake caches name other paths.
    "source=augusta-build-${devcontainerId},target=${containerWorkspaceFolder}/build,type=volume"
  ],
  // augustad's default listen port (config/augustad.example.yaml), published
  // on the host so a native Windows augustac reaches it at 127.0.0.1:27015.
  // UDP, which forwardPorts doesn't forward.
  "appPort": ["27015:27015/udp"],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      // The Linux-relevant subset of .vscode/extensions.json.
      "extensions": [
        "ms-vscode.cmake-tools",
        "ms-vscode.makefile-tools",
        "llvm-vs-code-extensions.lldb-dap",
        "llvm-vs-code-extensions.vscode-clangd",
        "shader-slang.slang-language-extension",
        "editorconfig.editorconfig",
        "esbenp.prettier-vscode",
        "redhat.vscode-yaml",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "sumneko.lua",
        "dwenegar.vscode-luacheck",
        "JohnnyMorganz.stylua",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "mkhl.shfmt",
        "timonwong.shellcheck",
        "tamasfe.even-better-toml",
        "github.vscode-github-actions"
      ],
      // .vscode/settings.json names the Windows venv's interpreter; uv sync
      // makes Linux's under bin/.
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/tools/.venv/bin/python"
      }
    }
  }
}
