# EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# C++ (Google C++ Style Guide, 2-space indent; 120-col per .clang-format)
[*.{h,hpp,hh,inl,c,cc,cpp,cxx}]
indent_size = 2
max_line_length = 120

# CMake
[{CMakeLists.txt,*.cmake}]
indent_size = 2

# Lua scripts (2-space indent, 120-col per stylua.toml)
[*.lua]
indent_size = 2
max_line_length = 120

# Python (120-col per ruff.toml)
[*.py]
max_line_length = 120

# Shell scripts and git hooks (2-space indent, as shfmt formats them)
[*.sh]
indent_size = 2
switch_case_indent = true

[.githooks/*]
indent_size = 2
switch_case_indent = true

# Data / config
[*.{json,yml,yaml,toml}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Windows-only scripts keep CRLF
[*.{ps1,psd1,bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
