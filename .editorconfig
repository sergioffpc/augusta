# EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# C++ (Google C++ Style Guide, 2-space indent; 120-col per .clang-format)
[*.{h,hpp,hh,inl,c,cc,cpp,cxx}]
indent_size = 2
max_line_length = 120

# CMake
[{CMakeLists.txt,*.cmake}]
indent_size = 2

# Lua scripts (2-space indent, 120-col per stylua.toml)
[*.lua]
indent_size = 2
max_line_length = 120

# Python (Google Python Style Guide: 80-col per ruff.toml)
[*.py]
max_line_length = 80

# Shell scripts and git hooks (Google Shell Style Guide: 2-space indent, case
# patterns indented, | && || starting the continued line, 80-col; shfmt formats
# by these)
[*.sh]
indent_size = 2
switch_case_indent = true
binary_next_line = true
max_line_length = 80

[.githooks/*]
indent_size = 2
switch_case_indent = true
binary_next_line = true
max_line_length = 80

# Data / config
[*.{json,yml,yaml,toml}]
indent_size = 2

# Markdown (Google Markdown style guide: 80-col, 4-space nesting, no trailing
# whitespace; a hard line break is a trailing backslash)
[*.md]
indent_size = 4
max_line_length = 80

# Windows-only scripts keep CRLF
[*.{bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
