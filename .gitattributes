# Enforce LF at the git level (mirrors .editorconfig, which only affects editors,
# not what actually gets committed regardless of a contributor's core.autocrlf).
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Cooked packs and raw Ed25519 key files are bytes, whatever they happen to
# contain (tests/fixtures/example-packs).
*.pack binary
*.key binary
*.pub binary

# Authored cue sounds are PCM WAV files (ADR-0020).
*.wav binary

# Fuzz seeds and crash fixtures are raw payloads, with no extension to go by
# (tests/fuzz/README.md).
tests/fuzz/corpus/** binary
tests/fuzz/regressions/** binary
