#!/bin/bash
# Auto-formats the staged files with the Makefile's format-files, the
# formatters `make format` runs, and stages what they changed. CI's format
# checks remain the actual gate if the hook is bypassed with --no-verify.

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[[ -n "${staged}" ]] || exit 0

# The formatters are the toolchain's, at this branch's pins (ADR-0077): a pull
# or a checkout that moved a pin stops here, not at CI.
if ! make -s --no-print-directory toolchain-check; then
  echo "pre-commit: the toolchain is not the one this branch pins:" \
    "run \`make toolchain\`." >&2
  exit 1
fi

# The staged files' contents as hashes, one a line, to tell what the
# formatters changed.
hashes() {
  echo "${staged}" | git hash-object --stdin-paths
}

before=$(hashes)
# One line, one space between files; tracked paths have no spaces.
make -s --no-print-directory format-files \
  FILES="$(echo "${staged}" | tr '\n' ' ')" || exit $?

# Stages only what a formatter changed, so a file staged in part keeps its
# unstaged changes out of the commit unless a formatter touched it.
changed=$(paste -d ' ' <(echo "${staged}") <(echo "${before}") <(hashes) \
  | awk '$2 != $3 { print $1 }')
if [[ -n "${changed}" ]]; then
  # shellcheck disable=SC2086 # one argument per file
  git add -- ${changed} || exit $?
fi
