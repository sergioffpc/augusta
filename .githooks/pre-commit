#!/bin/sh
# Auto-formats staged C++, YAML and Lua files. CI's format checks remain the actual
# gate if a local formatter is missing or the hook is bypassed with --no-verify.

cxx_files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^(src|tests)/.*\.(cpp|h)$' || true)
if [ -n "$cxx_files" ]; then
  if command -v clang-format >/dev/null 2>&1; then
    echo "$cxx_files" | while IFS= read -r f; do
      clang-format -i "$f" || exit $?
      git add "$f" || exit $?
    done
  else
    echo "pre-commit: clang-format not found on PATH - skipping C++ formatting (CI will still catch this)." >&2
  fi
fi

yaml_files=$(git diff --cached --name-only --diff-filter=ACMR |
  grep -E '(^\.yamlfmt$|^\.yamllint$|\.(yaml|yml)$)' |
  grep -vE '^charts/augustad/templates/|^clusters/onprem/flux-system/gotk-components\.yaml$' || true)
if [ -n "$yaml_files" ]; then
  if command -v yamlfmt >/dev/null 2>&1; then
    echo "$yaml_files" | while IFS= read -r f; do
      yamlfmt "$f" || exit $?
      git add "$f" || exit $?
    done
  else
    echo "pre-commit: yamlfmt not found on PATH - skipping YAML formatting (CI will still catch this)." >&2
  fi
fi

lua_files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.lua$' || true)
if [ -n "$lua_files" ]; then
  if command -v stylua >/dev/null 2>&1; then
    echo "$lua_files" | while IFS= read -r f; do
      stylua "$f" || exit $?
      git add "$f" || exit $?
    done
  else
    echo "pre-commit: stylua not found on PATH - skipping Lua formatting (CI will still catch this)." >&2
  fi
fi
