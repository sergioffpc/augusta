#!/bin/bash
# Runs the Makefile's lint-files on the files the push changes before pushing:
# format-check's linters, then clang-tidy and include-cleaner as tidy runs
# them. Git LFS uploads still run after the checks pass.

readonly ZERO_SHA=0000000000000000000000000000000000000000

# Hands the push to Git LFS, unless this run is the checks alone: macOS runs
# those in the dev container and LFS on the host, with the host's credentials.
# Arguments:
#   The pushed refs, then the hook's own arguments.
lfs_pre_push() {
  [[ -n "${PRE_PUSH_CHECKS_ONLY:-}" ]] && return
  printf '%s\n' "$1" | git lfs pre-push "${@:2}"
}

main() {
  local remote="$1"
  local push_refs
  push_refs=$(cat)

  if [[ -z "${PRE_PUSH_CHECKS_ONLY:-}" ]]; then
    command -v git-lfs >/dev/null 2>&1 || {
      echo "pre-push: git-lfs not found on PATH; install Git LFS before" \
        "pushing." >&2
      exit 2
    }
  fi

  # macOS has none of the linters nor a build: the checks run in the dev
  # container, against its debug build's compile commands.
  if [[ "$(uname -s)" = Darwin ]]; then
    printf '%s\n' "${push_refs}" \
      | scripts/dev-container.sh env PRE_PUSH_CHECKS_ONLY=1 \
        PRE_PUSH_WORKTREE="${PRE_PUSH_WORKTREE:-}" \
        .githooks/pre-push "$@" || exit $?
    lfs_pre_push "${push_refs}" "$@"
    exit $?
  fi

  # The debug build's compile commands, or the release build's in a checkout
  # that only ran `make test`, so the push needs no second build.
  local preset
  case "$(uname -s)" in
    MINGW* | MSYS* | CYGWIN*) preset=windows-debug ;;
    *) preset=linux-debug ;;
  esac
  if [[ ! -f "build/x64-${preset}/compile_commands.json" &&
    -f "build/x64-${preset%-debug}/compile_commands.json" ]]; then
    preset=${preset%-debug}
  fi

  # The files touched by the pushed commits the remote does not have yet: for
  # a new branch, its commits off develop/main; for an existing one, the new
  # ones.
  local files="" local_sha
  while read -r _ local_sha _ _; do
    [[ -n "${local_sha}" ]] || continue
    [[ "${local_sha}" = "${ZERO_SHA}" ]] && continue # deleting a branch
    files="${files}
$(git log --format= --name-only --diff-filter=ACMR "${local_sha}" \
      --not --remotes="${remote}")"
  done <<EOF
${push_refs}
EOF
  # `make prepush` checks the changes not committed yet as well, so they are
  # checked before the commit that would carry them, not after it.
  if [[ -n "${PRE_PUSH_WORKTREE:-}" ]]; then
    files="${files}
$(git diff --name-only --diff-filter=ACMR HEAD)
$(git ls-files --others --exclude-standard)"
  fi
  files=$(printf '%s\n' "${files}" | sort -u \
    | while IFS= read -r f; do [[ -f "${f}" ]] && echo "${f}"; done)

  if [[ -n "${files}" ]]; then
    echo "pre-push: linting $(echo "${files}" | wc -l | tr -d ' ')" \
      "changed file(s)..." >&2
    # One line, one space between files; tracked paths have no spaces.
    make -s --no-print-directory lint-files PRESET="${preset}" \
      FILES="$(echo "${files}" | tr '\n' ' ')" || {
      echo "pre-push: lint-files failed - fix the findings above, or push" \
        "with --no-verify to skip." >&2
      exit 1
    }
  fi

  lfs_pre_push "${push_refs}" "$@"
}

main "$@"
