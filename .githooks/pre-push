#!/bin/sh
# Runs clang-tidy on changed C++ files, yamllint on changed YAML files,
# luacheck on changed Lua files and taplo on changed TOML files before pushing. Git LFS uploads still run after both checks pass.

remote="$1"
push_refs=$(cat)

command -v git-lfs >/dev/null 2>&1 || {
  echo "pre-push: git-lfs not found on PATH; install Git LFS before pushing." >&2
  exit 2
}

case "$(uname -s)" in
  MINGW* | MSYS* | CYGWIN*) windows=1 build_dir=build/x64-windows-debug ;;
  *) windows=0 build_dir=build/x64-linux-debug ;;
esac

# The files touched by the pushed commits the remote does not have yet: for a
# new branch, its commits off develop/main; for an existing one, the new ones.
files=""
zero=0000000000000000000000000000000000000000
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ -n "$local_sha" ] || continue
  [ "$local_sha" = "$zero" ] && continue # deleting a remote branch
  files="$files
$(git log --format= --name-only --diff-filter=ACMR "$local_sha" --not --remotes="$remote")"
done <<EOF
$push_refs
EOF

# Lint YAML/config files changed by the commits being pushed. If the shared
# lint/ignore rules change, lint the whole tree. Helm templates and the generated
# Flux bundle are excluded by .yamllint.
yaml_config_changed=$(printf '%s\n' "$files" | grep -E '^\.(yamlfmt|yamllint|yamlignore|gitignore)$' || true)
if [ -n "$yaml_config_changed" ]; then
  yaml_files=.
else
  yaml_files=$(printf '%s\n' "$files" |
    grep -E '(^\.yamlfmt$|^\.yamllint$|\.(yaml|yml)$)' |
    grep -vE '^charts/augustad/templates/|^clusters/onprem/flux-system/gotk-components\.yaml$' |
    sort -u |
    while IFS= read -r f; do [ -f "$f" ] && echo "$f"; done)
fi

# Lint Lua scripts changed by the commits being pushed. If luacheck's rules
# (the engine sandbox's standard library among them) change, lint every script.
lua_config_changed=$(printf '%s\n' "$files" | grep -E '^\.luacheckrc$' || true)
if [ -n "$lua_config_changed" ]; then
  lua_files=$(git ls-files -- '*.lua')
else
  lua_files=$(printf '%s\n' "$files" | grep -E '\.lua$' |
    sort -u |
    while IFS= read -r f; do [ -f "$f" ] && echo "$f"; done)
fi

# Lint TOML files changed by the commits being pushed (taplo's own config
# among them, so a change to it is checked like any other).
toml_files=$(printf '%s\n' "$files" | grep -E '\.toml$' |
  sort -u |
  while IFS= read -r f; do [ -f "$f" ] && echo "$f"; done)

# src/client and src/modules/renderer are Windows-only, so CI's Linux run has
# no compile commands for them; PhysX's SSE headers break clang-tidy under
# MSVC's flags, so physics.cpp is linted by CI's Linux run alone. The audio
# module's output device builds from different sources on each platform, so
# each side skips the other's (as the Makefile's tidy target does).
changed_files=$files
files=$(echo "$files" | grep -E '^src/.*\.cpp$' |
  grep -vE '^src/(client|modules/renderer)/' |
  { if [ "$windows" = 1 ]; then
      grep -vxE 'src/modules/(physics/physics|audio/output_none)\.cpp'
    else
      grep -vxE 'src/modules/audio/(output_miniaudio|miniaudio)\.cpp'
    fi; } |
  sort -u |
  while IFS= read -r f; do [ -f "$f" ] && echo "$f"; done)

# The rest of the changed src and tests .cpp files, which get include-cleaner
# alone (as the Makefile's tidy target runs it, which says why -w): the tests
# and, on Windows, the Windows-only sources - those the debug build has compile
# commands for (its paths are absolute, with \\ for separators on Windows), so
# not the other platform's, and not physics.cpp under MSVC's flags.
include_files=""
if [ -f "$build_dir/compile_commands.json" ]; then
  compiled=$(tr '\\' '/' <"$build_dir/compile_commands.json" | tr -s '/' | grep '"file": ')
  include_files=$(echo "$changed_files" | grep -E '^(src|tests)/.*\.cpp$' |
    grep -vxF "$(printf '%s\n' "$files" src/modules/physics/physics.cpp)" |
    sort -u |
    while IFS= read -r f; do
      [ -f "$f" ] && echo "$compiled" | grep -qF "/$f\"" && echo "$f"
    done)
fi

if [ -z "$files" ] && [ -z "$include_files" ] && [ -z "$yaml_files" ] && [ -z "$lua_files" ] && [ -z "$toml_files" ]; then
  printf '%s\n' "$push_refs" | git lfs pre-push "$@"
  exit $?
fi

if [ -n "$files" ]; then
  if [ ! -f "$build_dir/compile_commands.json" ]; then
    echo "pre-push: $build_dir/compile_commands.json not found - configure the debug build first (make configure PRESET=$(basename "$build_dir" | sed 's/^x64-//')), or push with --no-verify to skip clang-tidy." >&2
    exit 1
  fi

  echo "pre-push: clang-tidy on $(echo "$files" | wc -l | tr -d ' ') changed file(s)..." >&2

  # -p=<dir>, never -p <dir>: through vcenv.ps1, PowerShell reads a bare -p as
  # its own parameter and clang-tidy would run without the compile commands
  # (see the Makefile's tidy target).
  if [ "$windows" = 1 ]; then
    # shellcheck disable=SC2086 # one argument per file; src/ paths have no spaces
    powershell -NoProfile -ExecutionPolicy Bypass -File scripts/vcenv.ps1 clang-tidy --quiet -p="$build_dir" $files
  else
    # shellcheck disable=SC2086
    clang-tidy --quiet -p="$build_dir" $files
  fi
  status=$?

  if [ "$status" -ne 0 ]; then
    echo "pre-push: clang-tidy failed - fix the warnings above, or push with --no-verify to skip." >&2
    exit 1
  fi
fi

if [ -n "$include_files" ]; then
  echo "pre-push: include-cleaner on $(echo "$include_files" | wc -l | tr -d ' ') changed file(s)..." >&2

  if [ "$windows" = 1 ]; then
    # shellcheck disable=SC2086 # one argument per file; src/ and tests/ paths have no spaces
    powershell -NoProfile -ExecutionPolicy Bypass -File scripts/vcenv.ps1 clang-tidy --quiet -p="$build_dir" \
      --checks=-*,misc-include-cleaner --extra-arg=-w $include_files
  else
    # shellcheck disable=SC2086
    clang-tidy --quiet -p="$build_dir" --checks=-*,misc-include-cleaner --extra-arg=-w $include_files
  fi
  status=$?

  if [ "$status" -ne 0 ]; then
    echo "pre-push: include-cleaner failed - fix the includes above (clang-tidy --fix can), or push with --no-verify to skip." >&2
    exit 1
  fi
fi

if [ -n "$yaml_files" ]; then
  if command -v yamllint >/dev/null 2>&1; then
    yamllint --strict -c .yamllint $yaml_files
  elif command -v uv >/dev/null 2>&1; then
    uv tool run --from yamllint==1.37.1 yamllint --strict -c .yamllint $yaml_files
  else
    echo "pre-push: yamllint (or uv) not found on PATH; install yamllint 1.37.1 before pushing YAML changes." >&2
    exit 2
  fi
  status=$?

  if [ "$status" -ne 0 ]; then
    echo "pre-push: yamllint failed - fix the YAML errors above, or push with --no-verify to skip." >&2
    exit 1
  fi
fi

if [ -n "$lua_files" ]; then
  command -v luacheck >/dev/null 2>&1 || {
    echo "pre-push: luacheck not found on PATH; install luacheck 1.2.0 before pushing Lua changes." >&2
    exit 2
  }
  # shellcheck disable=SC2086 # one argument per file; script paths have no spaces
  luacheck --quiet $lua_files
  status=$?

  if [ "$status" -ne 0 ]; then
    echo "pre-push: luacheck failed - fix the Lua warnings above, or push with --no-verify to skip." >&2
    exit 1
  fi
fi

if [ -n "$toml_files" ]; then
  command -v taplo >/dev/null 2>&1 || {
    echo "pre-push: taplo not found on PATH; install taplo 0.10.0 before pushing TOML changes." >&2
    exit 2
  }
  # shellcheck disable=SC2086 # one argument per file; TOML paths have no spaces
  taplo lint $toml_files 2>/dev/null
  status=$?

  if [ "$status" -ne 0 ]; then
    echo "pre-push: taplo lint failed - run it again to see why, or push with --no-verify to skip." >&2
    exit 1
  fi
fi

printf '%s\n' "$push_refs" | git lfs pre-push "$@"
