# Owners requested for review on every PR touching these paths. The last
# matching pattern wins, so the catch-all comes first. The entries below it
# name the sensitive areas (runtime, tools incl. pack signing, build and supply
# chain, cluster manifests, CI, docs) so a future second owner can be scoped
# to them; branch protection's "Require review from Code Owners" stays off
# while there is a single owner, who can't approve their own PRs.

*                   @sergioffpc

# Runtime.
/src/server/        @sergioffpc
/src/client/        @sergioffpc
/src/modules/       @sergioffpc

# Content and dev tools, including pack signing (tools/pack/src/pack/keys.py).
/tools/             @sergioffpc

# Build and supply chain.
/CMakeLists.txt     @sergioffpc
/CMakePresets.json  @sergioffpc
/cmake/             @sergioffpc
/vcpkg.json         @sergioffpc
/third_party/       @sergioffpc
/Dockerfile         @sergioffpc

# Deployment.
/charts/            @sergioffpc
/clusters/          @sergioffpc

# CI and repo policy.
/.github/           @sergioffpc

# Decisions and requirements: ADRs, architecture, requirements, roadmap,
# runbooks, agent docs.
/docs/              @sergioffpc
