# Build output (CMakePresets.json binaryDir per preset - build/x64-windows,
# build/x64-linux, etc. stay separate since Windows-native and WSL share the
# same checkout, see ENGINEERING.md)
build/
out/
bin/
obj/
[Dd]ebug/
[Rr]elease/
x64/
x86/

# CMake
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
_deps/

# Visual Studio
.vs/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.suo
*.user
*.userosscache
*.sdf
*.opensdf
*.VC.db
*.VC.opendb

# VS Code (project-wide settings are committed, personal overrides are not)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# Ninja / compile commands
.ninja_deps
.ninja_log
compile_commands.json

# Packages / vcpkg
vcpkg_installed/
packages/
.vcpkg-bincache/

# Python (tools/pack) build/install artifacts - the hermetic venv
# itself lives under -AssetsRoot (see above), never inside the checkout.
__pycache__/
*.pyc
*.egg-info/
.venv/

# Native _meshoptimizer/_textconv extension modules (tools/pack/
# cpp/*_bindings.cpp) and any runtime DLLs they need alongside them
# (DirectXTex, meshoptimizer, ...) - CMake builds these straight into this
# path (RUNTIME_OUTPUT_DIRECTORY); compiled binaries, not source.
# pybind11's actual filenames are ABI-tagged (e.g.
# _meshoptimizer.cp312-win_amd64.pyd) - Python resolves that back to the
# plain module name on import regardless.
tools/pack/src/pack/*.pyd
tools/pack/src/pack/*.dll

# Local runtime config (ADR-0034): machine-specific paths, never committed. The
# templates in config/ are named *.example.yaml and stay tracked. A scenario's
# parameters.lua (ADR-0039) lives under authoring/ or tools/pack/examples/ and
# is meant to be committed, so it is never matched here.
config/augustac.yaml
config/augustad.yaml

# OS
.DS_Store
Thumbs.db

# Logs
*.log
