# Build output (CMakePresets.json binaryDir per preset - build/x64-windows,
# build/x64-linux, etc. stay separate since the Windows-native and Linux builds
# share the same checkout, see ENGINEERING.md)
build/
out/
bin/
obj/
[Dd]ebug/
[Rr]elease/
x64/
x86/

# CMake
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
_deps/
CMakeUserPresets.json

# Visual Studio
.vs/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.suo
*.user
*.userosscache
*.sdf
*.opensdf
*.VC.db
*.VC.opendb

# VS Code (project-wide settings are committed, personal overrides are not)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# Ninja / compile commands
.ninja_deps
.ninja_log
compile_commands.json

# clangd index
.cache/

# Packages / vcpkg
vcpkg_installed/
packages/
.vcpkg-bincache/

# Python (tools/pack) build/install artifacts - the hermetic venv
# itself lives under -AssetsRoot (see above), never inside the checkout;
# .venv/ is the tools/ environment `uv sync` creates there.
__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/

# Native _meshoptimizer/_textconv extension modules (tools/pack/
# cpp/*_bindings.cpp) and any runtime DLLs they need alongside them
# (DirectXTex, meshoptimizer, ...) - CMake builds these straight into this
# path (RUNTIME_OUTPUT_DIRECTORY); compiled binaries, not source.
# pybind11's actual filenames are ABI-tagged (e.g.
# _meshoptimizer.cp312-win_amd64.pyd, or a .so on Linux) - Python resolves
# that back to the plain module name on import regardless.
tools/pack/src/pack/*.pyd
tools/pack/src/pack/*.so
tools/pack/src/pack/*.dll
# Likewise the Agents' _native module (tools/agent/native), which the root
# build writes into its package with the DLLs it needs on Windows.
tools/agent/src/augusta_agent/*.pyd
tools/agent/src/augusta_agent/*.so
tools/agent/src/augusta_agent/*.dll

# Local runtime config (ADR-0034): machine-specific paths, never committed. The
# templates in config/ are named *.example.yaml and stay tracked. A Parameters
# script (ADR-0039) lives under authoring/ or tools/composer/examples/ and is
# meant to be committed, so it is never matched here.
config/augustac.yaml
config/augustad.yaml

# Claude Code per-user state (project .claude/settings.json stays tracked)
.claude/settings.local.json
.claude/worktrees/
.claude/*.lock

# NVIDIA tooling output: Aftermath GPU crash dumps, Nsight Systems reports,
# Nsight Graphics captures
*.nv-gpudmp
*.nsys-rep
*.ngfx-capture

# OS
.DS_Store
Thumbs.db

# Logs
*.log
