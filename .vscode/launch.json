{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Server (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-linux/src/server/augusta_server",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "preLaunchTask": "CMake: build"
    },
    {
      "name": "Debug Client (MSVC)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\build-windows\\src\\client\\augusta_client.exe",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "CMake: build"
    }
  ]
}
