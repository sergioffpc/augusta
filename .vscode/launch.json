{
  "version": "0.2.0",
  // Each config's preLaunchTask (tasks.json) configures and builds only the
  // executable it launches, from the preset its build type names on this OS
  // (windows/windows-debug, linux/linux-debug, macos/macos-debug) - CMake
  // Tools' active preset plays no part.
  //
  // Every config starts from config/augustac.yaml / config/augustad.yaml
  // (ADR-0034): local copies of config/*.example.yaml, git-ignored because they
  // hold this machine's paths. Create them before the first F5.
  //
  // Each OS lists only the configs it can run: a config's "windows", "linux"
  // or "osx" section may set its presentation, so the (lldb) configs are
  // hidden on Windows and the (MSVC) configs everywhere else. One file serves
  // every OS, as the dev container mounts the Windows checkout itself.
  "configurations": [
    // The (lldb) configs below debug the Linux build of augustad (the real
    // deployment target, ADR-0026) and of augustac through LLVM's lldb-dap
    // extension, which runs the lldb-dap on PATH - the dev container's, from
    // the lldb package scripts/bootstrap.sh installs. On macOS (their "osx"
    // halves) they debug the macos presets' native build instead, with
    // Homebrew's lldb-dap, which is off PATH (scripts/bootstrap/macos.sh). On
    // Windows, the (MSVC) configs debug the native build instead.
    {
      "name": "Debug Server - Release (lldb)",
      "type": "lldb-dap",
      "request": "launch",
      "program": "${workspaceFolder}/build/x64-linux/src/server/augustad",
      "cwd": "${workspaceFolder}",
      "args": ["--config", "${workspaceFolder}/config/augustad.yaml"],
      "preLaunchTask": "Build augustad (Release)",
      "windows": { "presentation": { "hidden": true } },
      "osx": {
        "program": "${workspaceFolder}/build/arm64-macos/src/server/augustad",
        "debugAdapterExecutable": "/opt/homebrew/opt/lldb/bin/lldb-dap"
      }
    },
    {
      "name": "Debug Server - Debug (lldb)",
      "type": "lldb-dap",
      "request": "launch",
      "program": "${workspaceFolder}/build/x64-linux-debug/src/server/augustad",
      "cwd": "${workspaceFolder}",
      "args": ["--config", "${workspaceFolder}/config/augustad.yaml"],
      "preLaunchTask": "Build augustad (Debug)",
      "windows": { "presentation": { "hidden": true } },
      "osx": {
        "program": "${workspaceFolder}/build/arm64-macos-debug/src/server/augustad",
        "debugAdapterExecutable": "/opt/homebrew/opt/lldb/bin/lldb-dap"
      }
    },
    {
      "name": "Debug Client - Release (lldb)",
      "type": "lldb-dap",
      "request": "launch",
      "program": "${workspaceFolder}/build/x64-linux/src/client/augustac",
      "cwd": "${workspaceFolder}",
      "args": ["--config", "${workspaceFolder}/config/augustac.yaml"],
      "preLaunchTask": "Build augustac (Release)",
      "windows": { "presentation": { "hidden": true } },
      "osx": {
        "program": "${workspaceFolder}/build/arm64-macos/src/client/augustac",
        "debugAdapterExecutable": "/opt/homebrew/opt/lldb/bin/lldb-dap"
      }
    },
    {
      "name": "Debug Client - Debug (lldb)",
      "type": "lldb-dap",
      "request": "launch",
      "program": "${workspaceFolder}/build/x64-linux-debug/src/client/augustac",
      "cwd": "${workspaceFolder}",
      "args": ["--config", "${workspaceFolder}/config/augustac.yaml"],
      "preLaunchTask": "Build augustac (Debug)",
      // A Debug client runs under Vulkan's validation layer, vcpkg's
      // (ADR-0059): the loader finds its manifest through VK_ADD_LAYER_PATH,
      // and the manifest names the library alone, which the debug build's
      // lib folder holds.
      "env": {
        "VK_ADD_LAYER_PATH": "${workspaceFolder}/build/x64-linux-debug/vcpkg_installed/x64-linux/share/vulkan/explicit_layer.d",
        "LD_LIBRARY_PATH": "${workspaceFolder}/build/x64-linux-debug/vcpkg_installed/x64-linux/debug/lib"
      },
      "windows": { "presentation": { "hidden": true } },
      "osx": {
        "program": "${workspaceFolder}/build/arm64-macos-debug/src/client/augustac",
        "debugAdapterExecutable": "/opt/homebrew/opt/lldb/bin/lldb-dap",
        "env": {
          "VK_ADD_LAYER_PATH": "${workspaceFolder}/build/arm64-macos-debug/vcpkg_installed/arm64-osx/share/vulkan/explicit_layer.d",
          "DYLD_LIBRARY_PATH": "${workspaceFolder}/build/arm64-macos-debug/vcpkg_installed/arm64-osx/debug/lib"
        }
      }
    },
    {
      "name": "Debug Server - Release (MSVC)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\build\\x64-windows\\src\\server\\augustad.exe",
      "cwd": "${workspaceFolder}",
      "args": ["--config", "${workspaceFolder}/config/augustad.yaml"],
      "preLaunchTask": "Build augustad (Release)",
      "externalConsole": true,
      "presentation": { "hidden": true },
      "windows": { "presentation": { "hidden": false } }
    },
    {
      "name": "Debug Server - Debug (MSVC)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\build\\x64-windows-debug\\src\\server\\augustad.exe",
      "cwd": "${workspaceFolder}",
      "args": ["--config", "${workspaceFolder}/config/augustad.yaml"],
      "preLaunchTask": "Build augustad (Debug)",
      "externalConsole": true,
      "presentation": { "hidden": true },
      "windows": { "presentation": { "hidden": false } }
    },
    {
      "name": "Debug Client - Release (MSVC)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\build\\x64-windows\\src\\client\\augustac.exe",
      "cwd": "${workspaceFolder}",
      "args": ["--config", "${workspaceFolder}/config/augustac.yaml"],
      "preLaunchTask": "Build augustac (Release)",
      "externalConsole": true,
      "presentation": { "hidden": true },
      "windows": { "presentation": { "hidden": false } }
    },
    {
      "name": "Debug Client - Debug (MSVC)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\build\\x64-windows-debug\\src\\client\\augustac.exe",
      "cwd": "${workspaceFolder}",
      "args": ["--config", "${workspaceFolder}/config/augustac.yaml"],
      // A Debug client runs under Vulkan's validation layer, vcpkg's
      // (ADR-0059), which the system's loader finds through this.
      "environment": [
        {
          "name": "VK_ADD_LAYER_PATH",
          "value": "${workspaceFolder}\\build\\x64-windows-debug\\vcpkg_installed\\x64-windows\\debug\\bin"
        }
      ],
      "preLaunchTask": "Build augustac (Debug)",
      "externalConsole": true,
      "presentation": { "hidden": true },
      "windows": { "presentation": { "hidden": false } }
    }
  ]
}
