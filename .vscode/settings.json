{
  "editor.formatOnSave": true,
  "editor.rulers": [120],
  "files.autoSave": "onFocusChange",
  "[cpp]": { "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd" },
  "[c]": { "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd" },
  "[lua]": { "editor.defaultFormatter": "JohnnyMorganz.stylua" },
  "[toml]": { "editor.defaultFormatter": "tamasfe.even-better-toml" },
  "[yaml]": { "editor.formatOnSave": false },

  "C_Cpp.intelliSenseEngine": "disabled",
  "editor.detectIndentation": false,

  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}",
    "--background-index",
    "--clang-tidy",
    "--header-insertion=never"
  ],

  "stylua.searchBinaryInPath": true,

  "Lua.runtime.version": "Lua 5.5",
  "Lua.runtime.builtin": {
    "coroutine": "disable",
    "debug": "disable",
    "io": "disable",
    "os": "disable",
    "package": "disable",
    "utf8": "disable",
    "bit": "disable",
    "bit32": "disable",
    "ffi": "disable",
    "jit": "disable",
    "table.clear": "disable",
    "table.new": "disable"
  },
  "Lua.diagnostics.globals": ["server", "on_tick", "assign_spawns"],
  "Lua.diagnostics.disable": ["undefined-global"],
  "Lua.format.enable": false,
  "Lua.workspace.ignoreDir": [".vscode", ".cache", "build", "third_party"],

  "yaml.format.enable": false,
  "yaml.schemas": {
    "kubernetes": ["clusters/**/*.yaml"]
  },
  "files.associations": {
    "**/charts/*/templates/**": "helm"
  },

  "git.detectSubmodules": false,
  "git.autofetch": true,
  "git.inputValidation": true,
  "git.inputValidationSubjectLength": 72,

  "terminal.integrated.profiles.windows": {
    "Developer PowerShell": {
      "path": "cmd.exe",
      "args": [
        "/k",
        "for /f \"usebackq tokens=*\" %i in (`\"%ProgramFiles(x86)%\\Microsoft Visual Studio\\Installer\\vswhere.exe\" -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -find VC\\Auxiliary\\Build\\vcvars64.bat`) do call \"%i\" && powershell.exe -NoExit"
      ]
    }
  },

  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": true,
  "cmake.copyCompileCommands": "${workspaceFolder}/compile_commands.json",
  "cmake.preRunCoverageTarget": "coverage-clean",
  "cmake.postRunCoverageTarget": "coverage-report",
  "cmake.coverageInfoFiles": ["${workspaceFolder}/build/x64-linux-coverage/report/coverage.lcov"],

  "python.analysis.include": ["tools/**"],
  "python.defaultInterpreterPath": "${workspaceFolder}/tools/.venv/Scripts/python.exe",
  "python.testing.pytestEnabled": true,
  "python.testing.cwd": "${workspaceFolder}/tools/pack",
  "python.testing.pytestArgs": ["tests"],

  "files.exclude": {
    "**/build*": true
  },
  "search.exclude": {
    "third_party/**": true,
    "**/build*": true,
    "**/vcpkg_installed": true,
    ".cache/**": true,
    "**/.pytest_cache": true
  },
  "files.watcherExclude": {
    "third_party/**": true,
    "**/build*/**": true,
    "**/vcpkg_installed/**": true,
    ".cache/**": true,
    "**/.pytest_cache/**": true
  }
}
