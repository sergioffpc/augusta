{
  "version": "2.0.0",
  // One build task per executable, so a launch config's preLaunchTask builds
  // only what it runs: building the whole preset also relinks the other
  // executable, which fails (LNK1104 on Windows) while that one is still
  // running, and the debugger then starts the stale binary. Each builds the
  // active CMake Tools build preset.
  "tasks": [
    {
      "label": "CMake: build augustac",
      "type": "cmake",
      "command": "build",
      "targets": ["augustac"],
      "preset": "${command:cmake.activeBuildPresetName}",
      "group": "build",
      "problemMatcher": ["$msCompile", "$gcc"]
    },
    {
      "label": "CMake: build augustad",
      "type": "cmake",
      "command": "build",
      "targets": ["augustad"],
      "preset": "${command:cmake.activeBuildPresetName}",
      "group": "build",
      "problemMatcher": ["$msCompile", "$gcc"]
    }
  ]
}
