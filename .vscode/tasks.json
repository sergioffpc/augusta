{
  "version": "2.0.0",
  // One build task per executable and build type, so a launch config's
  // preLaunchTask builds only what it runs: building the whole preset also
  // relinks the other executable, which fails (LNK1104 on Windows) while that
  // one is still running, and the debugger then starts the stale binary. Each
  // task names its own preset per OS, not CMake Tools' active one, and runs
  // `make build`, which configures that preset first - so F5 works from a
  // fresh or deleted build/ tree.
  "tasks": [
    {
      "label": "Build augustac (Release)",
      "type": "shell",
      "command": "make build PRESET=linux TARGETS=augustac",
      "osx": { "command": "make build PRESET=macos TARGETS=augustac" },
      "windows": { "command": "make build PRESET=windows TARGETS=augustac" },
      "group": "build",
      "problemMatcher": ["$msCompile", "$gcc"]
    },
    {
      "label": "Build augustac (Debug)",
      "type": "shell",
      "command": "make build PRESET=linux-debug TARGETS=augustac",
      "osx": { "command": "make build PRESET=macos-debug TARGETS=augustac" },
      "windows": { "command": "make build PRESET=windows-debug TARGETS=augustac" },
      "group": "build",
      "problemMatcher": ["$msCompile", "$gcc"]
    },
    {
      "label": "Build augustad (Release)",
      "type": "shell",
      "command": "make build PRESET=linux TARGETS=augustad",
      "osx": { "command": "make build PRESET=macos TARGETS=augustad" },
      "windows": { "command": "make build PRESET=windows TARGETS=augustad" },
      "group": "build",
      "problemMatcher": ["$msCompile", "$gcc"]
    },
    {
      "label": "Build augustad (Debug)",
      "type": "shell",
      "command": "make build PRESET=linux-debug TARGETS=augustad",
      "osx": { "command": "make build PRESET=macos-debug TARGETS=augustad" },
      "windows": { "command": "make build PRESET=windows-debug TARGETS=augustad" },
      "group": "build",
      "problemMatcher": ["$msCompile", "$gcc"]
    }
  ]
}
