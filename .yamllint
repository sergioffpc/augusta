extends: default
yaml-files:
  - "*.yaml"
  - "*.yml"
  - ".yamllint"
  - ".yamlfmt"
ignore-from-file:
  - .gitignore
  - .yamlignore
rules:
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
  document-start: disable
  indentation:
    spaces: 2
    indent-sequences: consistent
  line-length: disable
  truthy:
    check-keys: false
