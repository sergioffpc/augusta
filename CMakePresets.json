{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 29, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "Windows (Ninja + clang-cl)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/x64-windows",
      "architecture": { "value": "x64", "strategy": "external" },
      "toolset": { "value": "host=x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_LINKER_TYPE": "LLD",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows Debug (Ninja + clang-cl)",
      "inherits": "windows",
      "binaryDir": "${sourceDir}/build/x64-windows-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AUGUSTA_LAVAPIPE": "ON"
      }
    },
    {
      "name": "windows-shipping",
      "displayName": "Windows Shipping (Ninja + clang-cl, no debug tools)",
      "inherits": "windows",
      "binaryDir": "${sourceDir}/build/x64-windows-shipping",
      "cacheVariables": {
        "AUGUSTA_DEBUG_TOOLS": "OFF"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux (Ninja + LLVM)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/x64-linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/LlvmToolchain.cmake",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VCPKG_INSTALL_OPTIONS": "--x-packages-root=$env{HOME}/.cache/augusta-vcpkg/packages;--x-buildtrees-root=$env{HOME}/.cache/augusta-vcpkg/buildtrees;--downloads-root=$env{HOME}/.cache/augusta-vcpkg/downloads"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug (Ninja + LLVM)",
      "inherits": "linux",
      "binaryDir": "${sourceDir}/build/x64-linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-shipping",
      "displayName": "Linux Shipping (Ninja + LLVM, no debug tools)",
      "inherits": "linux",
      "binaryDir": "${sourceDir}/build/x64-linux-shipping",
      "cacheVariables": {
        "AUGUSTA_DEBUG_TOOLS": "OFF"
      }
    },
    {
      "name": "macos",
      "displayName": "macOS arm64 (Ninja + LLVM, development only)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/arm64-macos",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/LlvmMacosToolchain.cmake",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "VCPKG_TARGET_TRIPLET": "arm64-osx",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VCPKG_INSTALL_OPTIONS": "--x-packages-root=$env{HOME}/.cache/augusta-vcpkg-macos/packages;--x-buildtrees-root=$env{HOME}/.cache/augusta-vcpkg-macos/buildtrees;--downloads-root=$env{HOME}/.cache/augusta-vcpkg-macos/downloads"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-debug",
      "displayName": "macOS arm64 Debug (Ninja + LLVM, development only)",
      "inherits": "macos",
      "binaryDir": "${sourceDir}/build/arm64-macos-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-san",
      "displayName": "Linux (clang, ASan + UBSan)",
      "inherits": "linux",
      "binaryDir": "${sourceDir}/build/x64-linux-san",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_INIT": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS_INIT": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "linux-fuzz",
      "displayName": "Linux (clang, libFuzzer + ASan)",
      "inherits": "linux",
      "binaryDir": "${sourceDir}/build/x64-linux-fuzz",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_INIT": "-fsanitize=address,fuzzer-no-link -fno-omit-frame-pointer -O1",
        "CMAKE_EXE_LINKER_FLAGS_INIT": "-fsanitize=address -l:libstdc++.so.6",
        "AUGUSTA_FUZZ": "ON"
      }
    },
    {
      "name": "linux-tsan",
      "displayName": "Linux (clang, TSan)",
      "inherits": "linux",
      "binaryDir": "${sourceDir}/build/x64-linux-tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_INIT": "-fsanitize=thread -fno-omit-frame-pointer -O1",
        "CMAKE_EXE_LINKER_FLAGS_INIT": "-fsanitize=thread"
      }
    },
    {
      "name": "linux-coverage",
      "displayName": "Linux (clang, source-based coverage)",
      "inherits": "linux",
      "binaryDir": "${sourceDir}/build/x64-linux-coverage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AUGUSTA_COVERAGE": "ON",
        "CMAKE_CXX_FLAGS_INIT": "-fprofile-instr-generate -fcoverage-mapping",
        "CMAKE_EXE_LINKER_FLAGS_INIT": "-fprofile-instr-generate"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows", "configurePreset": "windows" },
    { "name": "windows-debug", "configurePreset": "windows-debug" },
    { "name": "windows-shipping", "configurePreset": "windows-shipping" },
    { "name": "linux", "configurePreset": "linux" },
    { "name": "linux-debug", "configurePreset": "linux-debug" },
    { "name": "linux-shipping", "configurePreset": "linux-shipping" },
    { "name": "macos", "configurePreset": "macos" },
    { "name": "macos-debug", "configurePreset": "macos-debug" },
    { "name": "linux-san", "configurePreset": "linux-san" },
    {
      "name": "linux-fuzz",
      "configurePreset": "linux-fuzz",
      "targets": ["augusta_protocol_decode_fuzz", "augusta_pack_load_fuzz"]
    },
    { "name": "linux-tsan", "configurePreset": "linux-tsan" },
    { "name": "linux-coverage", "configurePreset": "linux-coverage" }
  ],
  "testPresets": [
    {
      "name": "windows",
      "configurePreset": "windows",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "^netcode$" } }
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "^netcode$" } }
    },
    {
      "name": "windows-shipping",
      "configurePreset": "windows-shipping",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "^netcode$" } }
    },
    {
      "name": "linux",
      "configurePreset": "linux",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "^netcode$" } }
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "^netcode$" } }
    },
    {
      "name": "linux-shipping",
      "configurePreset": "linux-shipping",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "^netcode$" } }
    },
    {
      "name": "linux-netcode",
      "configurePreset": "linux",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "^netcode$" } }
    },
    {
      "name": "macos",
      "configurePreset": "macos",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "^netcode$" } }
    },
    {
      "name": "macos-debug",
      "configurePreset": "macos-debug",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "^netcode$" } }
    },
    {
      "name": "linux-san",
      "configurePreset": "linux-san",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "^netcode$" } },
      "environment": {
        "LSAN_OPTIONS": "suppressions=${sourceDir}/tests/lsan.supp"
      }
    },
    {
      "name": "linux-tsan",
      "configurePreset": "linux-tsan",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "^netcode$" } },
      "environment": {
        "TSAN_OPTIONS": "suppressions=${sourceDir}/tests/tsan.supp second_deadlock_stack=1"
      }
    },
    {
      "name": "linux-coverage",
      "configurePreset": "linux-coverage",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "^netcode$" } },
      "environment": {
        "LLVM_PROFILE_FILE": "${sourceDir}/build/x64-linux-coverage/profiles/%p-%m.profraw"
      }
    }
  ]
}
