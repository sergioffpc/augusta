{
  "uid": "augustad-logs",
  "title": "Logs",
  "description": "augustad's log lines, by environment, server, level and text, from Loki (ADR-0049, ADR-0053).",
  "tags": [
    "augustad"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "augustad"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "title": "augustad",
      "icon": "external link",
      "targetBlank": false,
      "tooltip": "",
      "url": ""
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "includeAll": false,
        "multi": false,
        "options": [],
        "skipUrlSync": false
      },
      {
        "name": "namespace",
        "label": "Environment",
        "type": "custom",
        "query": "develop,staging",
        "current": {
          "selected": true,
          "text": "develop",
          "value": "develop"
        },
        "options": [
          {
            "selected": true,
            "text": "develop",
            "value": "develop"
          },
          {
            "selected": false,
            "text": "staging",
            "value": "staging"
          }
        ],
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "skipUrlSync": false
      },
      {
        "name": "scenario",
        "label": "Scenario",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(augustad_build_info{namespace=\"$namespace\"}, scenario)",
        "query": {
          "query": "label_values(augustad_build_info{namespace=\"$namespace\"}, scenario)",
          "refId": "scenario"
        },
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "skipUrlSync": false
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "description": "The line's level, its second field (ADR-0029).",
        "query": "TRACE,DEBUG,INFO,WARN,ERR,CRIT",
        "allValue": "[A-Z]+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "skipUrlSync": false
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "description": "Keeps the lines that contain this text, e.g. event=connected.",
        "query": "",
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        },
        "options": [
          {
            "selected": true,
            "text": "",
            "value": ""
          }
        ],
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Lines by level",
      "description": "The lines below, counted by their level (ADR-0029), from Loki (ADR-0053).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "queryType": "range",
          "legendFormat": "{{level}}",
          "expr": "sum by (level) (count_over_time({namespace=\"$namespace\", container=\"augustad\", pod=~\"augustad-${scenario:regex}-[a-z0-9]+-[a-z0-9]+\"} |~ `^\\S+ (${level:regex}) ` |= `$search` | regexp `^\\S+ (?P<level>[A-Z]+) ` [$__auto]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "TRACE"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "DEBUG"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "INFO"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "WARN"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ERR"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CRIT"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "dark-red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 1,
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "logs",
      "title": "Log",
      "description": "The selected servers' lines, newest first, from Loki (ADR-0053); they outlive their pods for 15 days.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "queryType": "range",
          "expr": "{namespace=\"$namespace\", container=\"augustad\", pod=~\"augustad-${scenario:regex}-[a-z0-9]+-[a-z0-9]+\"} |~ `^\\S+ (${level:regex}) ` |= `$search`"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "id": 2,
      "gridPos": {
        "h": 20,
        "w": 24,
        "x": 0,
        "y": 7
      }
    }
  ]
}
