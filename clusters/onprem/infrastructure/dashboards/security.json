{
  "uid": "augusta-security",
  "title": "Security",
  "description": "The Node's and the cluster's security logs in Loki (ADR-0057, ADR-0053): logins, requests by people, policy violations, Flux's warnings, kube-bench and the audit logs.",
  "tags": [
    "augusta",
    "security"
  ],
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "search",
        "label": "Search (regex)",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      }
    ]
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "schemaVersion": 39,
  "annotations": {
    "list": []
  },
  "editable": false,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "type": "logs",
      "title": "SSH logins, sudo and su",
      "description": "The Node's journal, its auth and authpriv facilities: every login sshd accepts or refuses, and every sudo and su (ADR-0057).",
      "id": 1,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"node/auth\"} |~ \"(?i)$search\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "type": "logs",
      "title": "Requests by people to the API server",
      "description": "The API server's audit log without its service accounts, nodes and k3s's own controllers: the cluster-admin identity (system:admin) and the operators (augusta:operators). Request and response bodies never reach Loki.",
      "id": 2,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"node/kube-audit\"} | json username=\"user.username\" | username !~ \"system:(serviceaccount|node|kube-|apiserver|k3s-|volume-|anonymous).*\" |~ \"(?i)$search\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "type": "logs",
      "title": "Kyverno policy violations",
      "description": "Each failed policy result Kyverno found, at admission or in its background scan, as the event it writes on the object.",
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"kubernetes/events\"} | logfmt | reason = \"PolicyViolation\" and kind !~ \".*Policy\" |~ \"(?i)$search\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "type": "logs",
      "title": "Flux warnings",
      "description": "Flux's warning events, a revision that fails its signature check (ADR-0056) among them.",
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"kubernetes/events\", namespace=\"flux-system\"} | logfmt | type = \"Warning\" |~ \"(?i)$search\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "type": "logs",
      "title": "kube-bench: FAIL and WARN",
      "description": "The daily kube-bench run's controls it does not pass; each is in clusters/onprem/node/cis-exceptions.md or is a defect.",
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{namespace=\"monitoring-node\", app=\"kube-bench\"} |~ `^\\[(FAIL|WARN)\\]` |~ \"(?i)$search\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
