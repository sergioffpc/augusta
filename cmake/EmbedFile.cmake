# Writes INPUT's bytes to OUTPUT as a C++ header declaring them as NAME, an
# inline constexpr unsigned char array, so a target can carry a data file in its
# executable instead of finding it at runtime:
#
#   cmake -DINPUT=<file> -DOUTPUT=<header> -DNAME=<identifier> -P EmbedFile.cmake
foreach(var INPUT OUTPUT NAME)
  if(NOT DEFINED ${var})
    message(FATAL_ERROR "EmbedFile.cmake needs -D${var}=...")
  endif()
endforeach()

file(READ ${INPUT} hex HEX)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
# Sixteen bytes a line, so the header stays readable in a diff tool.
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){16})" "\\1\n" bytes "${bytes}")
cmake_path(GET INPUT FILENAME input_name)
file(
  WRITE ${OUTPUT}
  "// Generated by cmake/EmbedFile.cmake from ${input_name}; do not edit.\n"
  "#pragma once\n"
  "inline constexpr unsigned char ${NAME}[] = {\n${bytes}\n};\n"
)
