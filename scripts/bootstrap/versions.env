# The toolchain's pinned versions, one per tool (ADR-0077): `make toolchain`
# installs each into the shared store and links it into .toolchain/bin. Bash
# sources this file and make can include it, so it holds NAME=VALUE lines and
# comments alone: no quotes, no spaces around "=". Bumping a tool is one line
# here; every checkout then runs `make toolchain`.

# PyPI's formatters and linters, at their packages' versions: ruff, shfmt-py,
# shellcheck-py, actionlint-py, gersemi, pymarkdownlnt and yamllint.
RUFF_VERSION=0.16.10
SHFMT_VERSION=4.2.0
SHELLCHECK_VERSION=0.11.0.1
ACTIONLINT_VERSION=1.7.12.25
GERSEMI_VERSION=0.29.2
PYMARKDOWN_VERSION=0.9.40
YAMLLINT_VERSION=1.37.1

# ctcache, whose clang-tidy-cache the Makefile's tidy target and CI's Lint steps
# run clang-tidy through. A commit, as ctcache isn't on PyPI.
CTCACHE_COMMIT=857b14271d3ded5511c2e6a60f2dc20c1e4b5680

# The Node that installs and runs Prettier, from its PyPI wheel, so no Node is
# installed on the system. Prettier's own version is pinned by package.json and
# package-lock.json beside this file.
NODEJS_WHEEL_VERSION=24.19.0

# The formatters and linters downloaded from their releases, each checked
# against the SHA-256 its platform's scripts/bootstrap/<platform>.sh holds:
# yamlfmt, StyLua, luacheck, Taplo and buf. luacheck has no release for macOS
# or Linux arm64, where the system's is linked instead and its version checked.
YAMLFMT_VERSION=0.21.0
STYLUA_VERSION=2.5.2
LUACHECK_VERSION=1.2.0
TAPLO_VERSION=0.10.0
BUF_VERSION=1.73.0
