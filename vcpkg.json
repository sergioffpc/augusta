{
  "name": "augusta",
  "version": "2.0.2",
  "dependencies": [
    "abseil",
    "benchmark",
    "blake3",
    "boost-beast",
    "boost-dll",
    "boost-interprocess",
    "boost-log",
    "boost-program-options",
    "flecs",
    "gamenetworkingsockets",
    "glm",
    "gtest",
    "libsodium",
    "lua",
    {
      "name": "miniaudio",
      "platform": "windows"
    },
    "physx",
    {
      "name": "prometheus-cpp",
      "default-features": false
    },
    "rapidcheck",
    "sol2",
    {
      "name": "steam-audio",
      "platform": "windows"
    },
    "yaml-cpp"
  ],
  "features": {
    "agent": {
      "description": "The Agents' Python module (tools/agent): the root CMakeLists.txt turns it on with AUGUSTA_TOOLS and the tools environment's Python",
      "dependencies": [
        "pybind11"
      ]
    }
  }
}
