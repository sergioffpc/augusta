{
  "name": "augusta",
  "version": "3.1.0",
  "dependencies": [
    "abseil",
    "benchmark",
    "blake3",
    "boost-beast",
    "boost-dll",
    "boost-interprocess",
    "boost-log",
    "boost-program-options",
    {
      "name": "directx-dxc",
      "host": true,
      "platform": "windows"
    },
    "flecs",
    "gamenetworkingsockets",
    {
      "name": "glfw3",
      "platform": "windows"
    },
    "glm",
    "gtest",
    {
      "name": "imgui",
      "features": [
        "glfw-binding"
      ],
      "platform": "windows"
    },
    "libsodium",
    "lua",
    {
      "name": "miniaudio",
      "platform": "windows"
    },
    {
      "name": "nvrhi",
      "platform": "windows"
    },
    "physx",
    {
      "name": "prometheus-cpp",
      "default-features": false
    },
    "rapidcheck",
    {
      "name": "shader-slang",
      "host": true,
      "platform": "windows"
    },
    "sol2",
    {
      "name": "steam-audio",
      "platform": "windows"
    },
    "yaml-cpp"
  ],
  "features": {
    "agent": {
      "description": "The Agents' Python module (tools/agent): the root CMakeLists.txt turns it on with AUGUSTA_TOOLS and the tools environment's Python",
      "dependencies": [
        "pybind11"
      ]
    }
  },
  "vcpkg-configuration": {
    "overlay-triplets": [
      "./triplets"
    ]
  }
}
